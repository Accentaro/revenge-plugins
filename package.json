{
    "name": "@accentaro/revenge-plugins",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node scripts/build.mjs",
        "build:dev": "node scripts/build.mjs --dev",
        "generate-index": "revenge-plugin generate-index",
        "plan-releases": "revenge-plugin plan-releases",
        "serve": "revenge-plugin serve",
        "lint": "biome lint plugins scripts --error-on-warnings",
        "lint:types": "tsc --noEmit",
        "prepare:tools": "node scripts/prepare-tools.mjs",
        "package": "node scripts/package.mjs"
    },
    "dependencies": {
        "@revenge-mod/devtools-client": "^1.4.0",
        "@revenge-mod/devtools-shared": "^1.3.0",
        "@revenge-mod/plugin-cli": "git+https://github.com/revenge-mod/revenge-plugin-cli.git#b41bab26bbc446e450673f8a24fb986b469d1e29",
        "@revenge-mod/types": "git+https://github.com/revenge-mod/revenge-types.git#565026d875a34d0567b26ab6f4e3e2e3938e85ad"
    },
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@biomejs/biome": "^2.5.12",
        "@swc/core": "1.16.2",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "fflate": "^0.8.3",
        "rain-worklet-compiler": "npm:react-native-reanimated@3.19.4",
        "react-native": "0.81.6",
        "typescript": "^7.0.2"
    },
    "overrides": {
        "@react-native/community-cli-plugin": "npm:dry-uninstall",
        "@react-native/codegen": "npm:dry-uninstall",
        "babel-jest": "npm:dry-uninstall",
        "babel-plugin-syntax-hermes-parser": "npm:dry-uninstall",
        "hermes-compiler": "npm:dry-uninstall",
        "jsc-android": "npm:dry-uninstall",
        "react-devtools-core": "npm:dry-uninstall",
        "recyclerlistview": "npm:dry-uninstall",
        "react-native-gesture-handler": "npm:dry-uninstall",
        "react-native-screens": "npm:dry-uninstall"
    },
    "trustedDependencies": [
        "@revenge-mod/plugin-cli",
        "@swc/core"
    ]
}
